<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:GroupBox name="Border" style="flex-grow: 1; align-items: center; justify-content: center; margin-left: 0; margin-bottom: 3px; margin-right: 0; margin-top: 0; padding-left: 0; padding-top: 0; padding-bottom: 0;">
        <ui:GroupBox name="LargeAspectBox" style="align-content: auto; justify-content: center; aspect-ratio: 1.777778; margin-bottom: 0; margin-left: 0; margin-right: 3px; margin-top: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; -unity-font-style: bold; align-self: auto; align-items: center; min-width: auto; min-height: auto; width: auto; max-width: 100%; max-height: 100%; flex-grow: 1;">
            <ui:GroupBox name="RealAspectBox" style="align-content: auto; justify-content: space-between; aspect-ratio: 1.777778; margin-bottom: 0; margin-left: 0; margin-right: 3px; margin-top: 0; padding-left: 0; padding-top: 0; padding-bottom: 0; -unity-font-style: bold; align-self: flex-start; align-items: flex-start; min-width: auto; min-height: auto; width: 100%;">
                <ui:GroupBox name="BreadBox" style="flex-direction: row; margin-left: 0; padding-left: 0; padding-bottom: 0; margin-bottom: 0; margin-top: 0; padding-top: 5px; height: 45px; width: 107px; justify-content: space-between; align-content: stretch; transform-origin: left top; scale: 1 1;">
                    <ui:Image source="project://database/Assets/Sprites/ui.png?fileID=5707218116961789024&amp;guid=e93682a38f2ac12d1aa87d1b2c77221e&amp;type=3#ui_0" name="bg" style="left: 0; top: 0; position: absolute; scale: 3.25 2; transform-origin: left top; width: 100%; height: 100%; min-width: 100%; min-height: 100%; max-width: 100%; max-height: 100%;"/>
                    <ui:Image source="project://database/Assets/Sprites/brot_steine.png?fileID=-2062102983&amp;guid=62cb19bada323aaa6bfa10a9756afff6&amp;type=3#brot_steine_12" data-source-type="IntoTheWoods.Inventory, Assembly-CSharp" name="bread" style="scale: 1 1; margin-right: 5px; padding-right: 0; margin-left: 5px; padding-left: 0; width: 100%; height: 100%; min-width: 100%; min-height: 100%; max-width: 100%; max-height: 100%; margin-top: 20px;">
                        <Bindings>
                            <ui:DataBinding property="source" data-source-path="breadSprites[0]" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Image>
                    <ui:Image data-source-type="IntoTheWoods.Inventory, Assembly-CSharp" name="stone" source="project://database/Assets/Sprites/brot_steine.png?fileID=4622151875478157621&amp;guid=62cb19bada323aaa6bfa10a9756afff6&amp;type=3#brot_steine_4" style="scale: 1 1; width: 100%; height: 100%; min-width: 100%; max-width: 100%; min-height: 100%; max-height: 100%; margin-right: 5px; margin-left: 5px; padding-right: 0; padding-left: 0; margin-top: 20px; visibility: hidden;">
                        <Bindings>
                            <ui:DataBinding property="source" data-source-path="stoneSprites[0]" binding-mode="ToTarget"/>
                            <ui:DataBinding property="style.visibility" data-source-path="HasStones" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Image>
                    <ui:Image data-source-type="IntoTheWoods.Inventory, Assembly-CSharp" name="net" source="project://database/Assets/Sprites/collectible_net.png?fileID=8182877775693398744&amp;guid=6f11d44c974ac763a8eed6e945cccbe5&amp;type=3#Hexenhaus_layer5_net_0" style="scale: 1.75 1.75; margin-left: 5px; padding-left: 0; width: 100%; height: 100%; min-width: 100%; min-height: 100%; max-width: 100%; max-height: 100%; margin-right: 5px; padding-right: 0; margin-top: 20px; visibility: hidden;">
                        <Bindings>
                            <ui:DataBinding property="style.visibility" data-source-path="HasNet" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Image>
                </ui:GroupBox>
            </ui:GroupBox>
        </ui:GroupBox>
    </ui:GroupBox>
</ui:UXML>
